        rf_distances="../results/tree_comparison/robinson_foulds_distances.txt",
        topo_summary="../results/tree_comparison/topological_summary.txt",     # ← renamed
    params:
        genes=GENES,
    conda:
        "envs/python.yaml",
    log:
        "../log/python/compare_trees.log"
    script:
        "scripts/compare_trees.py"


rule tree_concordance:
    input:
